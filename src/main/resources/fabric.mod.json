{
	"schemaVersion": 1,
	"id": "codenames",
	"version": "${version}",
	"name": "My Mod",
	"description": "Example mod description. Used as a template for all my mods.",
	"authors": [
		"fable"
	],
	"contact": {
		"homepage": "homepage",
		"sources": "source",
		"issues": "issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/codenames/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fable.codenames.Codenames"
		],
		"client": [
			"fable.codenames.client.CodenamesClient"
		]
	},
	"mixins": [
		"codenames.mixins.json",
		{
			"config": "codenames.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
